@page "/users"
@using BaseLibrary.DTOs
@using BaseLibrary.DTOs.BaseLibrary.DTOs
@using Microsoft.AspNetCore.Authorization
@inject HttpClient Http
@inject NavigationManager NavigationManager
@attribute [Authorize(Roles = "Admin")]

<div class="container mx-auto p-4">
    <h3 class="text-2xl font-bold mb-4">User Management</h3>

    @if (users == null)
    {
        <div class="flex justify-center">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-gray-900"></div>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="min-w-full bg-white shadow-md rounded-lg">
                <thead class="bg-gray-100">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    @foreach (var user in users)
                    {
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 whitespace-nowrap">@user.FullName</td>
                            <td class="px-6 py-4 whitespace-nowrap">@user.Email</td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                @if (user.EmailConfirmed)
                                {
                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                                        Verified
                                    </span>
                                }
                                else
                                {
                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">
                                        Pending
                                    </span>
                                }
                            </td>
                            @* <td class="px-6 py-4 whitespace-nowrap">@user.CreatedAt.ToShortDateString()</td> *@
                            <td class="px-6 py-4 whitespace-nowrap">
                                <button @onclick="() => ViewUserDetails(user.Id)" 
                                        class="text-indigo-600 hover:text-indigo-900 mr-2">
                                    View
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (selectedUser != null)
    {
        <UserDetails User="selectedUser" OnClose="CloseUserDetails" />
    }
</div>

@code {
    private List<UserDTO> users;
    private UserDTO selectedUser;
    private string error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            users = await Http.GetFromJsonAsync<List<UserDTO>>("api/authentication/users");
        }
        catch (Exception ex)
        {
            error = "Error loading users";
            // Log the error
        }
    }

    private async Task ViewUserDetails(int userId)
    {
        try
        {
            selectedUser = await Http.GetFromJsonAsync<UserDTO>($"api/authentication/users/{userId}");
        }
        catch (Exception ex)
        {
            error = "Error loading user details";
            // Log the error
        }
    }

    private void CloseUserDetails()
    {
        selectedUser = null;
    }
}