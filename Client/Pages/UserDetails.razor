@using BaseLibrary.DTOs
@using BaseLibrary.DTOs.BaseLibrary.DTOs

<div class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full"
     @onclick="OnClose">
    <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white"
         @onclick:stopPropagation="true">
        <div class="mt-3">
            <h3 class="text-lg font-medium leading-6 text-gray-900 mb-4">
                User Details
            </h3>
            <div class="mt-2">
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700">Full Name</label>
                    <div class="mt-1 text-sm text-gray-900">@User.FullName</div>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700">Email</label>
                    <div class="mt-1 text-sm text-gray-900">@User.Email</div>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700">Status</label>
                    <div class="mt-1">
                        @if (User.EmailConfirmed)
                        {
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                                Verified
                            </span>
                        }
                        else
                        {
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">
                                Pending
                            </span>
                        }
                    </div>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700">Created At</label>
                    <div class="mt-1 text-sm text-gray-900">@User.CreatedAt.ToString("g")</div>
                </div>
            </div>
        </div>

        <div class="mt-5 flex justify-end">
            <button @onclick="OnClose"
                    class="bg-gray-500 text-white px-4 py-2 rounded-md hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-gray-300">
                Close
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public UserDTO User { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
}