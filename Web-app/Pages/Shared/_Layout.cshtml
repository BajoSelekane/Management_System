<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Whooz-hoo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet" /> <!-- Font Awesome for icons -->
    <style>
        /* Custom styles for the sidebar */
        .sidebar {
            width: 250px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background-color: #343a40; /* Dark theme */
            color: #fff;
            overflow-y: auto;
        }

            .sidebar .nav-link {
                color: #fff;
                padding: 10px 15px;
                margin: 5px 0;
            }

                .sidebar .nav-link:hover {
                    background-color: #495057; /* Darker hover effect */
                }

            .sidebar .badge {
                float: right;
            }

        .main-content {
            margin-left: 250px; /* Offset for the sidebar */
            padding: 20px;
            min-height: 100vh;
            background-color: #f8f9fa; /* Light background for contrast */
            position: relative;
        }

        /* Watermark Background */
        .watermark {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: url( "data:location.svg/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='100%' height='100%'><text x='50%' y='50%' font-size='20' fill='rgba(0, 0, 0, 0.1)' transform='rotate(-45, 100, 100)' text-anchor='middle'>Whooz-Hoo 💬📱📲👥📨📩</text></svg>");
           
            pointer-events: none; /* Ensure the watermark doesn't interfere with clicks */
            z-index: 1;
        }

        /* Ensure content is above the watermark */
        .content {
            position: relative;
            z-index: 2;
        }

        @@media (max-width: 768px) {
            .sidebar {
                margin-left: -250px; /* Hide sidebar on smaller screens */
            }

            .main-content {
                margin-left: 0;
            }

            .sidebar.active {
                margin-left: 0; /* Show sidebar when toggled */
            }
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
        <div class="p-3">
            <h4 class="text-white">Social Media</h4>
        </div>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link active" href="#">
                    <i class="fas fa-home"></i> Home
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">
                    <i class="fas fa-users"></i> Friends
                    <span class="badge bg-danger">3</span> <!-- Notification badge -->
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">
                    <i class="fas fa-comments"></i> Messages
                    <span class="badge bg-primary">5</span> <!-- Notification badge -->
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">
                    <i class="fas fa-bell"></i> Notifications
                    <span class="badge bg-warning">2</span> <!-- Notification badge -->
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#">
                    <i class="fas fa-cog"></i> Settings
                </a>
            </li>
        </ul>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Watermark Background -->
        <div class="watermark"></div>

        <!-- Toggle Button for Mobile -->
        <button class="btn btn-dark d-md-none" type="button" onclick="toggleSidebar()">
            <i class="fas fa-bars"></i>
        </button>

        <!-- Page Content -->
        <div class="content">
            @RenderBody()
        </div>
    </div>

    <!-- Bootstrap JS and dependencies -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Function to toggle the sidebar on smaller screens
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('active');
        }
    </script>
</body>
</html>